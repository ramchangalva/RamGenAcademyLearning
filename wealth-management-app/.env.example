# Application Settings
APP_NAME=Wealth Management Planner
APP_VERSION=1.0.0
SECRET_KEY=your-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database
DATABASE_URL=sqlite:///./wealth_management.db
# Docker Compose (postgres) overrides DATABASE_URL inside the container — you only need:
# POSTGRES_PASSWORD=wealthpass
# WEB_PORT=9000

# Docker Compose — Postgres password for `db` service (must match web's connection)
POSTGRES_PASSWORD=wealthpass
WEB_PORT=9000
# Optional: docker compose image for registry push — default is wealthplanner:latest
# DOCKER_IMAGE=yourdockerhubuser/wealthplanner:latest

# Redis (Optional - for caching)
REDIS_URL=redis://localhost:6379/0

# Exchange Rate API
EXCHANGE_RATE_API_KEY=your-api-key-here
EXCHANGE_RATE_API_URL=https://api.exchangerate-api.com/v4/latest/USD
# Alternative: https://api.fixer.io/latest?access_key=YOUR_KEY

# Security
BCRYPT_ROUNDS=12
SESSION_TIMEOUT_MINUTES=60
CSRF_ENABLED=true

# AI advisor (optional). Users can also save an OpenAI key under Settings → API keys (encrypted).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# n8n / TradePulse signed webhook (optional; defaults to SECRET_KEY)
TRADING_SYNC_HMAC_SECRET=

# Environment
ENVIRONMENT=development
DEBUG=true
